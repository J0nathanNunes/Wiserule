# OpenRouter
OPENROUTER_API_KEY=sua_chave_aqui

# LegisWeb
LEGISWEB_TOKEN=seu_token
LEGISWEB_CODIGO_CLIENTE=seu_codigo

# Tavily
TAVILY_API_KEY=sua_chave

# Brave (fallback)
BRAVE_API_KEY=sua_chave

# Supabase (banco de dados)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_chave_service_role
SUPABASE_TABLE_ANALISES=analises
SUPABASE_TABLE_CORRELACAO=v_correlacao_completa

# App
APP_NAME=Wiserule
DEBUG=true

# Geranet (API NFSe)
GERANET_API_KEY=sua_chave_aqui

# Certificado Digital A1 (.pfx) — necessário para consultar NFSe via Geranet
# LOCAL: coloque o caminho do arquivo .pfx
# GERANET_CERT_PATH=C:/certificados/certificado.pfx
#
# RAILWAY: converta o .pfx para base64 e cole aqui
# (use o script scripts/gerar_cert_base64.py para gerar)
# GERANET_CERT_BASE64=base64_do_certificado_aqui
#
# --- MODO MULTI-CERTIFICADO (recomendado) ---
# Coloque os .pfx na pasta backend/certificados/ com nome {ANO}-{CNPJ}.pfx
# A senha deve ser a mesma para todos
GERANET_CERTS_DIR=backend/certificados
GERANET_CERT_PASSWORD=sua_senha
#
# --- MODO RAILWAY MULTI-CERT ---
# GERANET_CERTS_JSON={"07121135000316":"base64...","60833910001906":"base64..."}
#
# --- MODO CERTIFICADO ÚNICO (legado) ---
# GERANET_CERT_PATH=C:/caminho/certificado.pfx
# GERANET_CERT_BASE64=base64_do_certificado
# GERANET_CERT_PASSWORD=sua_senha