{
  "name": "wiserule-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute wiserule-db --file=./migrations/001_init.sql",
    "db:seed": "wrangler d1 execute wiserule-db --file=./migrations/002_seed.sql",
    "db:migrate:auth": "wrangler d1 execute wiserule-db --file=./migrations/003_auth.sql",
    "db:migrate:auth:remote": "wrangler d1 execute wiserule-db --remote --file=./migrations/003_auth.sql",
    "db:migrate:notifications:remote": "wrangler d1 execute wiserule-db --remote --file=./migrations/004_notificacoes.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "pdfjs-dist": "^4.7.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "wrangler": "^4.135.0",
    "typescript": "^5.6.0"
  }
}